import re
import os
import json
import shlex
import pandas as pd
from glob import glob

################################################################################
### Fetch data from config file

configfile: "workflow/config.yaml"
PACKAGE_DIR = config.get("package_dir", None)
VERSION = config.get("version", None)
BARCODEMAPPER_DB = config.get("barcodemapper_db", None)
BARCODEMAPPER_INDEX_BASE = config.get("barcodemapper_index_base", os.path.splitext(BARCODEMAPPER_DB)[0])
BARCODEMAPPER_INDEX_EXTENSION = config.get("barcodemapper_index_extension", "bt2l")
GENERATE_INDEX = config.get("generate_index", True)
BARCODEMAPPER_DB_HEADERS = config.get("barcodemapper_db_headers", None)
GENERATE_HEADERS = config.get("generate_headers", True)
BOLD_DB = config.get("bold_db", None)
UNITE_DB = config.get("unite_db", None)
BOLD_RETAIN = config.get("bold_retain", None)
UNITE_RETAIN = config.get("unite_retain", None)
OUTPUT_FILE = config.get("output_file", None)
TMP_DIR = config.get("tmp_dir", None)
BUILD_ONLY = config.get("build_only", None)
REPORT_FILE = config.get("report_file", None)
MAX_EDIT_PERCENT = config.get("max_edit_percent", 3.0)
MIN_COVERAGE = config.get("min_coverage", 80)
LEVELS = config.get("levels")
if LEVELS is None:
    LEVELS = {"custom": {"max_edit_percent": MAX_EDIT_PERCENT, "min_coverage": MIN_COVERAGE}}
LEVEL_NAMES = list(LEVELS)
OUTPUT_FILES = config.get("output_files")
if OUTPUT_FILES is None:
    OUTPUT_FILES = {"custom": OUTPUT_FILE}
MAX_HITS = config.get("max_hits", None)
KEEP_BAM = config.get("keep_bam", True)

wildcard_constraints:
    level="|".join(re.escape(name) for name in LEVEL_NAMES) or "(?!)",
    sample=r"[^/]+"


def extract_path(level, sample):
    return f"{TMP_DIR}/extract/{level}/{sample}.tsv"


def extract_temporary_files(sample):
    return [f"{extract_path(level, sample)}{suffix}"
            for level in LEVEL_NAMES for suffix in (".unsorted", ".sorted.tmp")]


def sort_commands(sample):
    return "\n".join(
        f"LC_ALL=C sort -s -t $'\\t' -k1,1 -o {shlex.quote(extract_path(level, sample) + '.sorted.tmp')} "
        f"{shlex.quote(extract_path(level, sample) + '.unsorted')}"
        for level in LEVEL_NAMES
    )


def commit_extract_commands(sample):
    return "\n".join(
        f"mv -f -- {shlex.quote(extract_path(level, sample) + '.sorted.tmp')} "
        f"{shlex.quote(extract_path(level, sample))}"
        for level in LEVEL_NAMES
    )
# Without a hit cap (bowtie2 -a) mapping needs far more memory and time, so
# scale the mapping request: 1M-pair benchmarks peaked at 43-55 GB (about
# 3.6x the input) against 22-24 GB when capped, and took up to 20 min per GB of input.
MAP_MEM_FACTOR = 3 if MAX_HITS is not None else 6
MAP_MIN_PER_GB = 12 if MAX_HITS is not None else 36
MIN_READ_LENGTH = config.get("min_read_length", 100)
COMPLEXITY_THRESHOLD = config.get("complexity_threshold", 30)
COMPLEXITY_ARGS = (
    f"--low_complexity_filter --complexity_threshold {COMPLEXITY_THRESHOLD}"
    if config.get("low_complexity_filter", True) else ""
)
ADAPTER_ARGS = (
    "" if config.get("adapter_r1", "auto") == "auto" else
    "--adapter_sequence " + shlex.quote(config["adapter_r1"]) +
    " --adapter_sequence_r2 " + shlex.quote(config["adapter_r2"])
)

################################################################################
### Input data

samples = []
if BUILD_ONLY == "no":

    with open(f"{TMP_DIR}/data/sample_to_reads1.json", "r") as f:
        SAMPLE_TO_READS1 = json.load(f)

    with open(f"{TMP_DIR}/data/sample_to_reads2.json", "r") as f:
        SAMPLE_TO_READS2 = json.load(f)

    samples = list(SAMPLE_TO_READS1.keys())

BARCODEMAPPER_BASE = BARCODEMAPPER_INDEX_BASE
BARCODEMAPPER_1_INDEX = f"{BARCODEMAPPER_BASE}.1.{BARCODEMAPPER_INDEX_EXTENSION}"
BARCODEMAPPER_2_INDEX = f"{BARCODEMAPPER_BASE}.2.{BARCODEMAPPER_INDEX_EXTENSION}"
BARCODEMAPPER_3_INDEX = f"{BARCODEMAPPER_BASE}.3.{BARCODEMAPPER_INDEX_EXTENSION}"
BARCODEMAPPER_4_INDEX = f"{BARCODEMAPPER_BASE}.4.{BARCODEMAPPER_INDEX_EXTENSION}"
BARCODEMAPPER_REV1_INDEX = f"{BARCODEMAPPER_BASE}.rev.1.{BARCODEMAPPER_INDEX_EXTENSION}"
BARCODEMAPPER_REV2_INDEX = f"{BARCODEMAPPER_BASE}.rev.2.{BARCODEMAPPER_INDEX_EXTENSION}"

################################################################################
### Setup the desired outputs

if BUILD_ONLY == "yes":
    rule all:
        input:
            BARCODEMAPPER_DB,
            BARCODEMAPPER_1_INDEX,
            BARCODEMAPPER_2_INDEX,
            BARCODEMAPPER_3_INDEX,
            BARCODEMAPPER_4_INDEX,
            BARCODEMAPPER_REV1_INDEX,
            BARCODEMAPPER_REV2_INDEX,
            BARCODEMAPPER_DB_HEADERS

if BUILD_ONLY == "no":
    rule all:
        input:
            list(OUTPUT_FILES.values()),
            REPORT_FILE,
            BARCODEMAPPER_DB_HEADERS,
            expand(f"{TMP_DIR}/bowtie/{{sample}}.bam", sample=samples) if KEEP_BAM else []

################################################################################
### Prepare database

if BOLD_DB or UNITE_DB:

    rule prepare_database:
        input:
            bold=BOLD_DB,
            unite=UNITE_DB
        output:
            BARCODEMAPPER_DB
        threads:
            1
        params:
            package_dir=PACKAGE_DIR,
            bold=BOLD_RETAIN,
            unite=UNITE_RETAIN
        resources:
            mem_mb=lambda wildcards, input, attempt: max(8*1024, int(input.size_mb * 3) * 2 ** (attempt - 1)),
            runtime=lambda wildcards, input, attempt: max(10, int(input.size_mb / 1024 * 5) * 2 ** (attempt - 1))
        message:
            "Preparing database"
        shell:
            """
            python {params.package_dir:q}/workflow/scripts/prepare_database.py -b {input.bold:q} -u {input.unite:q} -x {params.bold:q} -y {params.unite:q} -o {output:q}
            """

################################################################################
### Filter reads with fastp

rule fastp:
    input:
        r1=lambda wildcards: SAMPLE_TO_READS1[wildcards.sample],
        r2=lambda wildcards: SAMPLE_TO_READS2[wildcards.sample]
    output:
        r1 = f"{TMP_DIR}/fastp/{{sample}}_1.fq.gz",
        r2 = f"{TMP_DIR}/fastp/{{sample}}_2.fq.gz",
        fastp_html = f"{TMP_DIR}/fastp/{{sample}}.html",
        fastp_json = f"{TMP_DIR}/fastp/{{sample}}.json"
    threads:
        4
    resources:
        mem_mb=lambda wildcards, input, attempt: max(8*1024, int(input.size_mb * 5) * 2 ** (attempt - 1)),
        runtime=lambda wildcards, input, attempt: max(10, int(input.size_mb / 1024 * 10) * 2 ** (attempt - 1))
    message:
        "Using FASTP to trim adapters and low quality sequences for {wildcards.sample}"
    params:
        adapter_args=ADAPTER_ARGS,
        complexity_args=COMPLEXITY_ARGS,
        min_read_length=MIN_READ_LENGTH
    shell:
        """
        fastp \
            --in1 {input.r1:q} --in2 {input.r2:q} \
            --out1 {output.r1:q} --out2 {output.r2:q} \
            --trim_poly_g \
            --trim_poly_x \
            --n_base_limit 5 \
            --qualified_quality_phred 20 \
            --length_required {params.min_read_length} \
            {params.complexity_args} \
            --thread {threads} \
            --html {output.fastp_html:q} \
            --json {output.fastp_json:q} \
            {params.adapter_args}
        """

################################################################################
## Index BarcodeMapper database:

if GENERATE_INDEX:
    rule index_db:
        input:
            BARCODEMAPPER_DB
        output:
            index1=BARCODEMAPPER_1_INDEX,
            index2=BARCODEMAPPER_2_INDEX,
            index3=BARCODEMAPPER_3_INDEX,
            index4=BARCODEMAPPER_4_INDEX,
            indexrev1=BARCODEMAPPER_REV1_INDEX,
            indexrev2=BARCODEMAPPER_REV2_INDEX
        params:
            database = BARCODEMAPPER_BASE
        threads:
            24
        resources:
            # The input is gzipped FASTA (~7x compression for DNA) and bowtie2-build
            # peaks at roughly 3-4 bytes per uncompressed base, so scale from size_mb * 28
            mem_mb=lambda wildcards, input, attempt: max(8*1024, int(input.size_mb * 28) * 2 ** (attempt - 1)),
            runtime=lambda wildcards, input, attempt: max(60, int(input.size_mb / 1024 * 180)) * 2 ** (attempt - 1)
        message:
            "Indexing BarcodeMapper database with Bowtie2"
        shell:
            """
            bowtie2-build \
                --large-index \
                --threads {threads} \
                {input:q} {params.database:q}
            """

################################################################################
## Index BarcodeMapper database:

if GENERATE_HEADERS:
    rule db_headers:
        input:
            BARCODEMAPPER_DB
        output:
            BARCODEMAPPER_DB_HEADERS
        threads:
            1
        params:
            reader="gzip -cd" if BARCODEMAPPER_DB.lower().endswith(".gz") else "cat"
        resources:
            mem_mb=lambda wildcards, input, attempt: max(8*1024, int(input.size_mb * 5) * 2 ** (attempt - 1)),
            runtime=lambda wildcards, input, attempt: max(10, int(input.size_mb / 1024 * 30) * 2 ** (attempt - 1))
        message:
            "Generating taxonomic overview of database"
        shell:
            """
            {params.reader} {input:q} | grep '^>' | cut -d'|' -f3- | sort -u | tr ';' '\t' > {output:q}
            """

################################################################################
### Map quality-filtered reads against BarcodeMapper database

rule bowtie2_mapping:
    input:
        index1=BARCODEMAPPER_1_INDEX,
        index2=BARCODEMAPPER_2_INDEX,
        index3=BARCODEMAPPER_3_INDEX,
        index4=BARCODEMAPPER_4_INDEX,
        indexrev1=BARCODEMAPPER_REV1_INDEX,
        indexrev2=BARCODEMAPPER_REV2_INDEX,
        r1 = f"{TMP_DIR}/fastp/{{sample}}_1.fq.gz",
        r2 = f"{TMP_DIR}/fastp/{{sample}}_2.fq.gz",
    output:
        tsvs = expand(f"{TMP_DIR}/extract/{{level}}/{{sample}}.tsv", level=LEVEL_NAMES, sample="{sample}"),
        stats = f"{TMP_DIR}/extract/{{sample}}.stats.json",
        bam = f"{TMP_DIR}/bowtie/{{sample}}.bam" if KEEP_BAM else []
    log:
        f"{TMP_DIR}/logs/bowtie2/{{sample}}.log"
    params:
        database = BARCODEMAPPER_BASE,
        bam_args = lambda wildcards: ["--bam-out", f"{TMP_DIR}/bowtie/{wildcards.sample}.bam.tmp", "--threads", "4"] if KEEP_BAM else [],
        hits_arg = "-a" if MAX_HITS is None else f"-k {MAX_HITS}",
        package_dir=PACKAGE_DIR,
        level_args = [argument for name, settings in LEVELS.items()
                      for argument in ("--level", f"{name}:{settings['max_edit_percent']}:{settings['min_coverage']}")],
        output_pattern=lambda wildcards: f"{TMP_DIR}/extract/{{level}}/{wildcards.sample}.tsv.unsorted",
        cleanup=lambda wildcards: extract_temporary_files(wildcards.sample) +
                [f"{TMP_DIR}/extract/{wildcards.sample}.stats.json.tmp"] +
                ([f"{TMP_DIR}/bowtie/{wildcards.sample}.bam.tmp"] if KEEP_BAM else []),
        sort_commands=lambda wildcards: sort_commands(wildcards.sample),
        commit_commands=lambda wildcards: commit_extract_commands(wildcards.sample),
        bam_commit=lambda wildcards: f"mv -f -- {shlex.quote(f'{TMP_DIR}/bowtie/{wildcards.sample}.bam.tmp')} "
                                     f"{shlex.quote(f'{TMP_DIR}/bowtie/{wildcards.sample}.bam')}" if KEEP_BAM else ""
    threads:
        20
    resources:
        # Measured on the default database (~15 GB of index plus 100k read pairs):
        # peak memory about 36 GB (2.3x the input) and 1 h 50 min on 8 threads with
        # bowtie2 -a. Request MAP_MEM_FACTOR x the input in memory and MAP_MIN_PER_GB
        # minutes per GB of input (3x and 12 min capped; 6x and 36 min with -a,
        # see above); retries double both.
        mem_mb=lambda wildcards, input, attempt: max(8*1024, int(input.size_mb * MAP_MEM_FACTOR) * 2 ** (attempt - 1)),
        runtime=lambda wildcards, input, attempt: max(10, int(input.size_mb / 1024 * MAP_MIN_PER_GB)) * 2 ** (attempt - 1)
    message:
        "Mapping {wildcards.sample} to BarcodeMapper database with Bowtie2"
    shell:
        """
        set -euo pipefail
        mkdir -p "$(dirname {log:q})"
        exec 2> {log:q}
        cleanup() {{ rm -f -- {params.cleanup:q}; }}
        trap cleanup EXIT
        bowtie2 \
            --time \
            --no-unal \
            --threads {threads} \
            -x {params.database:q} \
            -1 {input.r1:q} \
            -2 {input.r2:q} \
            {params.hits_arg} \
            --seed 1337 \
        | python {params.package_dir:q}/workflow/scripts/stream_extract_taxonomy.py \
            {params.level_args:q} \
            --output-pattern {params.output_pattern:q} \
            --stats-json {output.stats:q}.tmp \
            --sample {wildcards.sample:q} {params.bam_args:q}
        {params.sort_commands}
        {params.commit_commands}
        mv -f -- {output.stats:q}.tmp {output.stats:q}
        {params.bam_commit}
        """

################################################################################
### Calculate the number of reads assigned to each taxonomic assignment

rule assign_taxonomy:
    input:
        f"{TMP_DIR}/extract/{{level}}/{{sample}}.tsv"
    output:
        f"{TMP_DIR}/taxonomy/{{level}}/{{sample}}.tsv"
    log:
        f"{TMP_DIR}/logs/taxonomy/{{level}}/{{sample}}.log"
    params:
        package_dir=PACKAGE_DIR
    threads:
        1
    resources:
        mem_mb=lambda wildcards, input, attempt: max(8*1024, int(input.size_mb * 10) * 2 ** (attempt - 1)),
        runtime=lambda wildcards, input, attempt: max(10, int(input.size_mb / 1024 * 2) * 2 ** (attempt - 1))
    message:
        "Assigning taxonomy to {wildcards.sample} at {wildcards.level} stringency"
    script:
        "{params.package_dir}/workflow/scripts/assign_taxonomy.py"

################################################################################
### Aggregate values to obtain an additive quantitative taxonomic hierarchy

rule aggregate_taxonomy:
    input:
        f"{TMP_DIR}/taxonomy/{{level}}/{{sample}}.tsv"
    output:
        f"{TMP_DIR}/aggregate/{{level}}/{{sample}}.tsv"
    log:
        f"{TMP_DIR}/logs/aggregate/{{level}}/{{sample}}.log"
    params:
        package_dir=PACKAGE_DIR
    threads:
        1
    resources:
        mem_mb=lambda wildcards, input, attempt: max(8*1024, int(input.size_mb * 10) * 2 ** (attempt - 1)),
        runtime=lambda wildcards, input, attempt: max(10, int(input.size_mb / 1024 * 2) * 2 ** (attempt - 1))
    message:
        "Assigning taxonomy"
    script:
        "{params.package_dir}/workflow/scripts/aggregate_taxonomy.py"

################################################################################
### Merge data from different samples in a final dataset

if BUILD_ONLY == "no":

    rule merge_taxonomy:
        input:
            lambda wildcards: expand(f"{TMP_DIR}/aggregate/{wildcards.level}/{{sample}}.tsv", sample=samples)
        output:
            f"{TMP_DIR}/merged/{{level}}.tsv"
        log:
            f"{TMP_DIR}/logs/merge/{{level}}.log"
        params:
            package_dir=PACKAGE_DIR,
            samples=samples
        threads:
            1
        resources:
            mem_mb=lambda wildcards, input, attempt: max(8*1024, int(input.size_mb * 10) * 2 ** (attempt - 1)),
            runtime=lambda wildcards, input, attempt: max(10, int(input.size_mb / 1024 * 2) * 2 ** (attempt - 1))
        message:
            "Assigning taxonomy"
        script:
            "{params.package_dir}/workflow/scripts/merge_taxonomy.py"

    rule publish_results:
        input:
            expand(f"{TMP_DIR}/merged/{{level}}.tsv", level=LEVEL_NAMES)
        output:
            list(OUTPUT_FILES.values())
        log:
            f"{TMP_DIR}/logs/publish_results.log"
        params:
            temporary=[f"{path}.tmp" for path in OUTPUT_FILES.values()],
            copy_commands="\n".join(
                f"mkdir -p -- {shlex.quote(os.path.dirname(OUTPUT_FILES[level]))}\n"
                f"cp -f -- {shlex.quote(f'{TMP_DIR}/merged/{level}.tsv')} {shlex.quote(OUTPUT_FILES[level] + '.tmp')}\n"
                f"mv -f -- {shlex.quote(OUTPUT_FILES[level] + '.tmp')} {shlex.quote(OUTPUT_FILES[level])}"
                for level in LEVEL_NAMES
            )
        threads:
            1
        resources:
            mem_mb=1024,
            runtime=10
        message:
            "Publishing merged taxonomy tables"
        shell:
            """
            set -euo pipefail
            mkdir -p "$(dirname {log:q})"
            exec 2> {log:q}
            cleanup() {{ rm -f -- {params.temporary:q}; }}
            trap cleanup EXIT
            {params.copy_commands}
            """

################################################################################
### Generate HTML report

rule html_report:
    input:
        merged=list(OUTPUT_FILES.values()),
        stats=expand(f"{TMP_DIR}/extract/{{sample}}.stats.json", sample=samples) if BUILD_ONLY == "no" else []
    output:
        REPORT_FILE
    log:
        f"{TMP_DIR}/logs/html_report.log"
    threads:
        1
    params:
        package_dir=PACKAGE_DIR,
        version=VERSION,
        report_args=[argument for level in LEVEL_NAMES
                     for argument in ("--input", f"{level}={OUTPUT_FILES[level]}")] +
                    [argument for level, settings in LEVELS.items()
                     for argument in ("--limits", f"{level}={settings['max_edit_percent']}:{settings['min_coverage']}")] +
                    [argument for sample in samples
                     for argument in ("--stats", f"{TMP_DIR}/extract/{sample}.stats.json")]
    resources:
        mem_mb=lambda wildcards, input, attempt: max(8*1024, int(input.size_mb * 3) * 2 ** (attempt - 1)),
        runtime=lambda wildcards, input, attempt: max(10, int(input.size_mb / 1024 * 5) * 2 ** (attempt - 1))
    message:
        "Generating plots"
    shell:
        """
        set -euo pipefail
        mkdir -p "$(dirname {log:q})"
        exec 2> {log:q}
        cleanup() {{ rm -f -- {output:q}.tmp; }}
        trap cleanup EXIT
        python {params.package_dir:q}/workflow/scripts/html_report.py {params.report_args:q} --output {output:q}.tmp --version {params.version:q}
        mv -f -- {output:q}.tmp {output:q}
        """
